{
  "name": "selenorizon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "South-pole Sun and Earth window planner for candidate lunar landing regions",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "figures": "node --experimental-strip-types scripts/figures.ts",
    "verify": "npm run typecheck && npm run test && npm run validate && npm run build",
    "deploy": "npm run build && npx netlify-cli deploy --prod --dir=dist"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astronomia": "^4.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^31.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^3.2.4"
  }
}
